{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "apps/*/src/index.ts",
    "apps/mcp-server/bin/stdio-launcher.cjs",
    "packages/*/src/index.ts",
    "scripts/*.mjs"
  ],
  "project": [
    "apps/*/bin/**/*.cjs",
    "apps/*/src/**/*.{ts,tsx}",
    "packages/*/src/**/*.{ts,tsx}",
    "scripts/**/*.{js,mjs}"
  ],
  "ignoreFiles": ["**/__tests__/**", "**/*.test.ts"],
  "ignoreIssues": {
    "packages/contracts/src/public/schemas.ts": ["duplicates"]
  }
}
