{
  "name": "@kiwi/mcp-server",
  "version": "1.0.0",
  "private": true,
  "bin": {
    "kiwi-mcp-stdio": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "KIWI_TEST_ALLOW_STUB=1 KIWI_FORCE_ACCESS_MODE=stub vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kiwi/adapters": "workspace:*",
    "@kiwi/contracts": "workspace:*",
    "@kiwi/core": "workspace:*",
    "@kiwi/ops": "workspace:*",
    "@kiwi/runtime": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.0.2",
    "vitest": "^4.0.0",
    "typescript": "^5.4.5"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
