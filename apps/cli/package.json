{
  "name": "@kiwi/cli",
  "version": "1.0.0",
  "bin": {
    "kiwi": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "kiwi": "tsx src/index.ts",
    "test": "KIWI_TEST_ALLOW_STUB=1 KIWI_FORCE_ACCESS_MODE=stub vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kiwi/adapters": "workspace:*",
    "@kiwi/contracts": "workspace:*",
    "@kiwi/core": "workspace:*",
    "@kiwi/ops": "workspace:*",
    "@kiwi/runtime": "workspace:*",
    "chalk": "^5.0.0",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.0.2",
    "tsx": "^4.7.3",
    "typescript": "^5.4.5",
    "vitest": "^4.0.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
